PORT=3001
LOCAL_API_TOKEN=
AI_RPM_LIMIT=30
BACKUP_PASSPHRASE=


DEEPGRAM_API_KEY=
DEEPGRAM_MODEL="nova-3"
DEEPGRAM_LANGUAGE="es"

# El Cofre (extensión Chrome) usa el mismo proxy live / DEEPGRAM_API_KEY.
# Cargar unpacked desde dist-extension/ tras `npm run build:extension`.

DEEPGRAM_CHUNK_SECONDS="50"
DEEPGRAM_SYNC_MAX_SECONDS="55"
DEEPGRAM_CHUNK_DELAY_MS="400"
DEEPGRAM_TIMEOUT_MS="90000"
DEEPGRAM_MAX_CHUNKS="24"
DEEPGRAM_MAX_EMPTY_STREAK="6"

# Groq — ENR / extracts (default en Config → LLM rápido)
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MODEL_FAST="openai/gpt-oss-20b"

# Cola LLM: 1 petición a la vez + delay (evita 429)
LLM_QUEUE_DELAY_MS="800"

# Fallback local si Groq cae o responde 429.
# El tag debe estar bajado (`ollama pull …`). Si llama3 no existe, se usa el primero de `ollama list`.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

COHERE_API_KEY=

# Cerebro principal (RAG, chat, purifier, KG, enciclopedia…)
# Por defecto el runtime usa Stealth vía OpenRouter (app_settings);
# Groq es el default de LLM rápido (ENR). Cohere sigue seleccionable.
COHERE_MODEL="command-r-plus-08-2024"

# Tareas más livianas / alto volumen (cleanup STT, esencias, eventos)
COHERE_MODEL_FAST="command-r-08-2024"

# OCR multimodal (ingesta visión + cuadernos). Fallback si Unlimited-OCR no está.
COHERE_VISION_MODEL="command-a-vision-07-2025"

# OpenRouter — Stealth / ox-alpha (cerebro por defecto)
OPENROUTER_API_KEY=
OPENROUTER_MODEL="stealth/ox-alpha"
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE="Deprocast"

# Unlimited-OCR (Baidu) — sidecar vLLM, no corre dentro de Node.
# docker run --rm --gpus all --network host --ipc host \
#   vllm/vllm-openai:unlimited-ocr baidu/Unlimited-OCR \
#   --trust-remote-code \
#   --logits_processors vllm.model_executor.models.unlimited_ocr:NGramPerReqLogitsProcessor \
#   --no-enable-prefix-caching --mm-processor-cache-gb 0
# Hopper: vllm/vllm-openai:unlimited-ocr-cu129
UNLIMITED_OCR_URL=
UNLIMITED_OCR_MODEL="baidu/Unlimited-OCR"
UNLIMITED_OCR_TIMEOUT_MS="1200000"
NOTEBOOK_OCR_BACKEND="auto"

# Mnemosyne — memoria semántica
COHERE_EMBED_MODEL="embed-v4.0"
COHERE_RERANK_MODEL="rerank-v3.5"

# Throttling entre llamadas LLM (purifier hace varias seguidas)
COHERE_REQUEST_DELAY_MS="2000"

# Explorador IDA — cuarentena. V1 = puente manual (prompt + pegar JSON).
# La API Sonar queda para más adelante; sin key el /research/run usa mock.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL="sonar-pro"
PERPLEXITY_TIMEOUT_MS="180000"

# Sello L72 (HMAC). Vacío = derivado del id de la RUN actual.
DEPRO_LATTICE_KEY=

# ffmpeg (split de audio, silencios, mejora). Vacío = tools/ → ~/bin → PATH.
FFMPEG_PATH=

# Detección de silencios en criba (ffmpeg silencedetect)
AUDIO_SILENCE_NOISE_DB="-35"
AUDIO_SILENCE_MIN_SEC="3"

# Pre-generar audio mejorado al terminar STT (0 = lazy al primer toggle)
AUDIO_ENHANCE_ON_INGEST="0"
